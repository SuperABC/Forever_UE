[
{
	"milestone": "game_start",
	"visible": false,
	"triggers": [{"type": "game_start"}],
	"dialogs": [],
	"changes": [
		{"type": "create_timer", "name": "$$(self.name)_$$(self.idx)_update", "time": "08:01:00", "category": "citizen", "label": "$$self.name"},
	],
	"subsequences": ["daily_update", "begin_work", "end_work", "buy_item", "free_challenge"]
},
{
	"milestone": "daily_update",
	"visible": false,
	"drop": "false",
	"triggers": [{"type": "time_up", "name": "$$(self.name)_$$(self.idx)_update"}],
	"dialogs": [],
	"changes": [
		{"type": "create_timer", "name": "$$(self.name)_$$(self.idx)_update", "time": "00:00:00", "category": "citizen", "label": "$$self.name"},
		{"type": "create_timer", "name": "$$(self.name)_$$(self.idx)_begin_work", "time": "$$self.signin_time", "category": "citizen", "label": "$$self.name"},
		{"type": "create_timer", "name": "$$(self.name)_$$(self.idx)_end_work", "time": "$$self.signout_time", "category": "citizen", "label": "$$self.name"},
	],
	"subsequences": []
},
{
	"milestone": "begin_work",
	"visible": false,
	"drop": "false",
	"triggers": [{"type": "time_up", "name": "$$(self.name)_$$(self.idx)_begin_work"}],
	"dialogs": [],
	"changes": [
		{"type": "npc_navigate", "name": "$$self.name", "destination": "$$self.work_address"}
	],
	"subsequences": ["arrive_work"]
},
{
	"milestone": "arrive_work",
	"visible": false,
	"drop": "true",
	"triggers": [{"type": "npc_arrive", "name": "$$self.name", "address": "$$self.work_address"}],
	"dialogs": [],
	"changes": [
		{"type": "add_option", "name": "$$self.name", "option": "购物"},
		{"type": "add_option", "name": "$$self.name", "option": "挑战"}
	],
	"subsequences": []
},
{
	"milestone": "end_work",
	"visible": false,
	"drop": "false",
	"triggers": [{"type": "time_up", "name": "$$(self.name)_$$(self.idx)_end_work"}],
	"dialogs": [],
	"changes": [
		{"type": "remove_option", "name": "$$self.name", "option": "购物"},
		{"type": "remove_option", "name": "$$self.name", "option": "挑战"},
		{"type": "npc_navigate", "name": "$$self.name", "destination": "$$self.home_address"}
	],
	"subsequences": []
},
{
	"milestone": "buy_item",
	"visible": false,
	"drop": "false",
	"triggers": [{"type": "option_dialog", "name": "$$self.name", "option": "购物"}],
	"dialogs": [],
	"changes": [
		{"type": "open_shop", "saler": "$$self.name"}
	],
	"subsequences": []
},
{
	"milestone": "free_challenge",
	"visible": false,
	"drop": "false",
	"triggers": [{"type": "option_dialog", "name": "$$self.name", "option": "挑战"}],
	"dialogs": [
		{"list": [
			{"speaker": "$$self.name", "content": "挑战规则：成功奖励100以及一个container，失败惩罚100。"},
			[
				{
					"option": "参加挑战",
					"changes": [
						{"type": "start_puzzle", "puzzle": "flappy"}
					]
				},
				{
					"option": "放弃",
					"changes": [
						{"type": "deactivate_milestone", "milestone": "challenge_result"}
					]
				}
			]
		]}
	],
	"changes": [],
	"subsequences": ["challenge_result"]
},
{
	"milestone": "challenge_result",
	"visible": false,
	"triggers": [{"type": "puzzle_result", "result": 0}],
	"dialogs": [
		{"condition": "$$local.result < 0", "list": [
			{"content": "挑战失败！"},
		]},
		{"condition": "$$local.result > 0", "list": [
			{"content": "挑战成功！"},
		]}
	],
	"changes": [
		{"condition": "$$local.result < 0", "type": "bank_transaction", "amount": -100},
		{"condition": "$$local.result > 0", "type": "bank_transaction", "amount": 100},
	],
	"subsequences": ["success_notify", "fail_penalty"]
},
{
	"milestone": "success_notify",
	"visible": false,
	"triggers": [{"type": "transaction_result", "result": true}],
	"dialogs": [
		{"list": [
			{"speaker": "$$self.name", "content": "一百块钱给你了。"},
		]}
	],
	"changes": [
		{"type": "give_object", "object": "container"},
		{"type": "deactivate_milestone", "milestone": "success_notify"},
		{"type": "deactivate_milestone", "milestone": "fail_penalty"},
	],
	"subsequences": ["receive_object"]
},
{
	"milestone": "fail_penalty",
	"visible": false,
	"triggers": [{"type": "transaction_result", "result": false}],
	"dialogs": [
		{"list": [
			{"speaker": "$$self.name", "content": "一百块钱都没有，穷逼。"},
		]}
	],
	"changes": [
		{"type": "deactivate_milestone", "milestone": "success_notify"},
		{"type": "deactivate_milestone", "milestone": "fail_penalty"},
	],
	"subsequences": []
},
{
	"milestone": "receive_object",
	"visible": false,
	"drop": true,
	"triggers": [{"type": "object_result", "object": "container"}],
	"dialogs": [
		{"condition": "$$local.result == false", "list": [
			{"speaker": "$$self.name", "content": "但container你身上没地方放了。"},
		]},
		{"condition": "$$local.result == true", "list": [
			{"speaker": "$$self.name", "content": "container也给你了。"},
		]},
	],
	"changes": [],
	"subsequences": []
},
]